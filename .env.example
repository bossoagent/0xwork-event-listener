# Environment Configuration

# Base RPC URL - Use a free key from Alchemy/Infura for production
# Get free key: https://alchemy.com (search "Base")
# Example: https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.public.blastapi.io

# Optional: Webhook URL for real-time alerts (bonus feature)
# Send JSON to Discord/Telegram webhook
WEBHOOK_URL=
